# Copy to `.env` (repo root, next to docker-compose.yml) and fill in.
# The real .env is gitignored — these are documented defaults, not secrets.

# ── beer-api (Docker Compose runtime) ───────────────────────────────
# Allowed CORS origins for the API — comma-separated, scheme+host, NO trailing
# slash. Read by docker compose at `up` time. Lock to your deployed frontend
# origin(s) in production; the compose default is "*" if unset.
CORS_ORIGIN=https://beer-viz.vercel.app

# Host dir holding the served beer.duckdb + aggregates.json. Defaults to the
# repo's ./data; set an absolute path on hosts that don't hold the repo.
# DATA_DIR=/srv/beer

# ── frontend (Vite build) ───────────────────────────────────────────
# Base URL of the beer-api. When set, the per-recipe views fetch from the API
# instead of bundling corpus.json. Leave unset for local/offline dev.
# VITE_BEER_API_BASE=https://apis.ginoclement.com/beer
