node_modules
dist
*.local
.DS_Store
src/generated

# crawled/synced recipe data. The parsed recipe corpus (recipes.jsonl) IS
# committed so Vercel's build:data folds it into recipes.json at deploy time
# (the site is built from committed sources — it can't see your local files).
# The raw page cache and crawl checkpoint stay local-only.
data/brewersfriend/*
!data/brewersfriend/recipes.jsonl
data/brewfather

# local DuckDB corpus database + exploration rollups from build-corpus.mjs
*.duckdb
*.duckdb.wal
data/corpus-aggregates.json
