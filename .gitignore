node_modules
dist
*.local
.DS_Store
src/generated

# local env files (compose runtime + Vite build vars). .env.example is committed.
.env
.env.*
!.env.example

# crawled/synced recipe data. The parsed recipe corpus (recipes.jsonl) IS
# committed so Vercel's build:data folds it into recipes.json at deploy time
# (the site is built from committed sources — it can't see your local files).
# The raw page cache and crawl checkpoint stay local-only.
data/brewersfriend/*
!data/brewersfriend/recipes.jsonl
data/brewfather

# local DuckDB corpus database + exploration rollups from build-corpus.mjs
*.duckdb
*.duckdb.wal
data/corpus-aggregates.json

# beer-api serving artifacts, built into the canonical data dir by build-db.mjs
# (beer.duckdb is covered by *.duckdb above)
data/aggregates.json
data/projection.ndjson

# cloudflare tunnel credentials — never commit
infra/cloudflared/creds.json

# beer-api build artifacts if DATA_DIR is pointed back inside the app dir
apps/beer-api/data/
